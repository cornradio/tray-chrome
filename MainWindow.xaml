<Window x:Class="TrayChrome.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Tray Chrome"
        Height="640"
        Width="360"
        MinWidth="200"
        MinHeight="150"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    
    <Window.Resources>
        <Style x:Key="BrowserMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <TextBlock Name="SubmenuArrow" Text="›" DockPanel.Dock="Right" Margin="12,0,0,0" Visibility="Collapsed"/>
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                                </DockPanel>
                            </Border>
                            <Popup Name="PART_Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="{DynamicResource BrowserMenuBackground}"
                                        BorderBrush="{DynamicResource BrowserMenuDivider}" BorderThickness="1" Padding="4" CornerRadius="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrowserMenuHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BrowserContextMenuStyle" TargetType="ContextMenu">
            <Style.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource BrowserMenuItemStyle}"/>
                <Style TargetType="Separator">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Separator">
                                <Border Height="1" Margin="8,4" Background="{DynamicResource BrowserMenuDivider}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabHeaderStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 自定义按钮样式 -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#666"/>
                                <Setter Property="Foreground" Value="#DDD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <!-- 外层容器，用于创建阴影效果 -->
    <Border Name="MainBorder" Background="#2D2D30" CornerRadius="8" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="0" ShadowDepth="0" Opacity="0.6" BlurRadius="15"/>
        </Border.Effect>

        <Grid Name="MainContentGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        
        <!-- 顶部地址栏 -->
        <Border Grid.Row="0" Name="TopToolbar" Background="#3C3C3C" BorderBrush="#555" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>
                
                <!-- 汉堡菜单按钮 -->
                <Label Grid.Column="0" Name="HamburgerMenu" 
                       Background="Transparent" Foreground="#FFFFFF"
                       Margin="2" 
                       Content="☰"
                       Cursor="SizeAll"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"/>
                
                <!-- 地址栏 -->
                <TextBox Grid.Column="1" Name="AddressBar" 
                         Background="#444" Foreground="#FFFFFF" 
                         BorderThickness="0" BorderBrush="#888"
                         Margin="0,3,5,3" Padding="8,5" 
                         Text="https://tva.cornradio.org/?name=search"
                         KeyDown="AddressBar_KeyDown"
                         TextChanged="AddressBar_TextChanged"
                         LostKeyboardFocus="AddressBar_LostKeyboardFocus"
                         FontSize="10"
                         FontWeight="Normal"
                         VerticalContentAlignment="Center"/>

                <!-- 关闭按钮 -->
                <Button Grid.Column="2" Name="CloseButton" Content="×"
                        Style="{StaticResource ToolbarButtonStyle}" Click="CloseButton_Click"/>
            </Grid>
        </Border>
        
        <!-- WebView2 浏览器控件 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Name="TabToolbar" Background="{Binding Background, ElementName=TopToolbar}"
                       Visibility="Collapsed">
                <Button Name="NewTabButton" DockPanel.Dock="Right" Content="+"
                        ToolTip="新标签页 (Ctrl+T)" Click="NewTab_Click" Width="28"
                        Style="{StaticResource TabHeaderStyle}"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Name="TabHeaders" Orientation="Horizontal"/>
                </ScrollViewer>
            </DockPanel>
            <Grid Grid.Row="1" Name="BrowserHost">
                <wv2:WebView2 Name="webView"/>
            </Grid>
        </Grid>
        
        <!-- 底部功能按钮栏 -->
        <Border Grid.Row="2" Name="BottomToolbar" Background="#3C3C3C" BorderBrush="#555" BorderThickness="0,1,0,0">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                
                <!-- 后退按钮 -->
                <Button Grid.Column="0" Name="BackButton" Content="‹" 
                        Style="{StaticResource ToolbarButtonStyle}" Click="BackButton_Click"
                        MouseRightButtonUp="BackButton_RightClick"/>
                
                <!-- 前进按钮 -->
                <Button Grid.Column="1" Name="ForwardButton" Content="›" 
                        Style="{StaticResource ToolbarButtonStyle}" Click="ForwardButton_Click"
                        MouseRightButtonUp="ForwardButton_RightClick"/>
                
                <!-- 刷新按钮 -->
                <Button Grid.Column="2" Name="RefreshButton" Content="⟳" 
                        Style="{StaticResource ToolbarButtonStyle}" Click="RefreshButton_Click"/>
                
                <!-- 收藏夹按钮 -->
                <Button Grid.Column="3" Name="BookmarkButton" Content="★" 
                        Style="{StaticResource ToolbarButtonStyle}" Click="BookmarkButton_Click"
                        ToolTip="收藏夹">
                    <Button.ContextMenu>
                        <ContextMenu Name="BookmarkContextMenu" Style="{StaticResource BrowserContextMenuStyle}"
                                     Opened="BrowserMenu_Opened">
                            <MenuItem Header="添加到收藏夹" Click="AddBookmark_Click"/>
                            <MenuItem Header="书签管理器" Click="ShowSettings_Bookmarks_Click"/>
                            <Separator Name="BookmarkSeparator"/>
                            <!-- 动态添加的收藏项将在这里 -->
                            <Separator Name="DynamicSeparatorEnd" Visibility="Collapsed"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                
                <!-- UA切换按钮 -->
                <Button Grid.Column="6" Name="UAButton" Content="▯" 
                        Style="{StaticResource ToolbarButtonStyle}" Click="UAButton_Click"
                        ToolTip="切换用户代理 (当前: 手机)"/>
                <!-- Popup按钮 -->
                <Button Grid.Column="5" Name="PopupButton" Content="⫘" 
                        Style="{StaticResource ToolbarButtonStyle}" Click="PopupButton_Click"
                        ToolTip="在新标签页打开"/>
                    <!-- 日夜模式切换按钮 -->
                <Button Grid.Column="4" Name="DarkModeButton" Content="☾" 
                        Style="{StaticResource ToolbarButtonStyle}" Click="DarkModeButton_Click"
                        ToolTip="切换暗色模式"/>

                <!-- 代理按钮 -->
                <Button Grid.Column="7" Name="ProxyButton" 
                        Style="{StaticResource ToolbarButtonStyle}" Click="ProxyButton_Click"
                        ToolTip="代理设置">
                    <Button.Content>
                        <Grid Width="14" Height="14">
                            <Ellipse Name="ProxyRing" Stroke="White" StrokeThickness="2" Fill="Transparent"/>
                        </Grid>
                    </Button.Content>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="开启/关闭代理" Click="ProxyToggle_Click" IsCheckable="True" Name="ProxyToggleMenuItem2"/>
                            <MenuItem Header="代理设置页面" Click="ProxySettings_Click"/>
                            <MenuItem Header="重启实例 (生效Proxy)" Click="RestartApp_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- 置顶按钮 -->
                <Button Grid.Column="8" Name="TopMostButton"
                        Style="{StaticResource ToolbarButtonStyle}" Click="TopMostButton_Click"
                        ToolTip="取消置顶">
                    <Path Width="13" Height="15" Stretch="Uniform"
                          Fill="{Binding Foreground, ElementName=TopMostButton}"
                          Data="M 4,0 L 10,0 L 9,6 L 12,9 L 12,10 L 7.7,10 L 7,15 L 6.3,10 L 2,10 L 2,9 L 5,6 Z"/>
                </Button>
                        
                <!-- 拖动按钮 -->
                <Label Grid.Column="11" Name="DragButton" Content="" 
                       Background="Transparent" Foreground="White"
                       FontSize="16" Cursor="SizeAll"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"
                       ToolTip="拖拽移动窗口"/>
                       
                <!-- 缩小按钮 -->
                <Button Grid.Column="9" Name="ZoomOutButton" Content="-" 
                        Style="{StaticResource ToolbarButtonStyle}" Click="ZoomOut_Click"
                        ToolTip="缩小"/>
                <!-- 放大按钮 -->
                <Button Grid.Column="10" Name="ZoomInButton" Content="+" 
                        Style="{StaticResource ToolbarButtonStyle}" Click="ZoomIn_Click"
                        ToolTip="放大"/>

                
                <!-- 窗口调整按钮 ↘ -->
                <Label Grid.Column="12" Name="ResizeButton" Content="" 
                       Background="Transparent" Foreground="White"
                       FontSize="16" Cursor="SizeNWSE"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"
                       ToolTip="拖拽调整窗口大小"/>

            </Grid>
        </Border>
        </Grid>
    </Border>
</Window>