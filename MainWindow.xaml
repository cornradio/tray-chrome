<Window x:Class="TrayChrome.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Tray Chrome"
        Height="640"
        Width="360"
        MinWidth="200"
        MinHeight="150"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    
    <Window.Resources>
        <Style x:Key="BrowserMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <TextBlock Name="SubmenuArrow" Text="›" DockPanel.Dock="Right" Margin="12,0,0,0" Visibility="Collapsed"/>
                                    <TextBlock Name="MenuCheck" Text="✓" Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                                </DockPanel>
                            </Border>
                            <Popup Name="PART_Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="{DynamicResource BrowserMenuBackground}"
                                        BorderBrush="{DynamicResource BrowserMenuDivider}" BorderThickness="1" Padding="4" CornerRadius="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrowserMenuHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="MenuCheck" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BrowserContextMenuStyle" TargetType="ContextMenu">
            <Style.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource BrowserMenuItemStyle}"/>
                <Style TargetType="Separator">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Separator">
                                <Border Height="1" Margin="8,4" Background="{DynamicResource BrowserMenuDivider}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabHeaderStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 自定义按钮样式 -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#666"/>
                                <Setter Property="Foreground" Value="#DDD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <!-- 外层容器，用于创建阴影效果 -->
    <Border Name="MainBorder" Background="#2D2D30" CornerRadius="8" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="0" ShadowDepth="0" Opacity="0.6" BlurRadius="15"/>
        </Border.Effect>

        <Grid Name="MainContentGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        
        <!-- 顶部地址栏 -->
        <Border Grid.Row="0" Name="TopToolbar" Background="#3C3C3C" BorderBrush="#555" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>
                
                <!-- 汉堡菜单按钮 -->
                <Label Grid.Column="0" Name="HamburgerMenu" 
                       Background="Transparent" Foreground="#FFFFFF"
                       Margin="2" 
                       Content="☰"
                       Cursor="SizeAll"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"/>
                
                <!-- 地址栏 -->
                <Button Grid.Column="1" Name="SearchButton"
                        Style="{StaticResource ToolbarButtonStyle}" Click="SearchButton_Click"
                        ToolTip="页内搜索 (Ctrl+F)">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Stroke="{Binding Foreground, ElementName=SearchButton}" StrokeThickness="1.5"
                          Data="M 9,5 A 4,4 0 1 1 1,5 A 4,4 0 1 1 9,5 M 8,8 L 13,13"/>
                </Button>

                <TextBox Grid.Column="2" Name="AddressBar"
                         Background="#444" Foreground="#FFFFFF" 
                         BorderThickness="0" BorderBrush="#888"
                         Margin="0,3,5,3" Padding="8,5" 
                         Text="https://tva.cornradio.org/?name=search"
                         KeyDown="AddressBar_KeyDown"
                         TextChanged="AddressBar_TextChanged"
                         LostKeyboardFocus="AddressBar_LostKeyboardFocus"
                         FontSize="10"
                         FontWeight="Normal"
                         VerticalContentAlignment="Center"/>

                <!-- 关闭按钮 -->
                <Button Grid.Column="3" Name="TopMoreButton" Content="…" Width="30" Visibility="Collapsed"
                        Style="{StaticResource ToolbarButtonStyle}" Click="MoreButton_Click" ToolTip="更多"/>
                <Button Grid.Column="4" Name="CloseButton" Content="×"
                        Style="{StaticResource ToolbarButtonStyle}" Click="CloseButton_Click"/>
            </Grid>
        </Border>
        
        <!-- WebView2 浏览器控件 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Name="TabToolbar" Background="{Binding Background, ElementName=TopToolbar}"
                       Visibility="Collapsed" PreviewMouseWheel="TabToolbar_PreviewMouseWheel">
                <Button Name="NewTabButton" DockPanel.Dock="Right" Content="+"
                        ToolTip="新标签页 (Ctrl+T)" Click="NewTab_Click" Width="28"
                        Style="{StaticResource TabHeaderStyle}"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Name="TabHeaders" Orientation="Horizontal"/>
                </ScrollViewer>
            </DockPanel>
            <!-- WebView2 是原生窗口，WPF 控件无法覆盖在网页上，查找栏单独占一行 -->
            <Border Grid.Row="1" Name="FindBar" Visibility="Collapsed"
                    Background="{Binding Background, ElementName=TopToolbar}"
                    BorderBrush="{Binding BorderBrush, ElementName=TopToolbar}" BorderThickness="0,0,0,1">
                <DockPanel Margin="4,2">
                    <Button DockPanel.Dock="Right" Content="×" Width="24" ToolTip="关闭 (Esc)"
                            Click="FindClose_Click" Style="{StaticResource TabHeaderStyle}"
                            Foreground="{Binding Foreground, ElementName=AddressBar}"/>
                    <Button DockPanel.Dock="Right" Content="↓" Width="24" ToolTip="下一个 (Enter / F3)"
                            Click="FindNext_Click" Style="{StaticResource TabHeaderStyle}"
                            Foreground="{Binding Foreground, ElementName=AddressBar}"/>
                    <Button DockPanel.Dock="Right" Content="↑" Width="24" ToolTip="上一个 (Shift+Enter / Shift+F3)"
                            Click="FindPrevious_Click" Style="{StaticResource TabHeaderStyle}"
                            Foreground="{Binding Foreground, ElementName=AddressBar}"/>
                    <TextBlock Name="FindCount" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0"
                               FontSize="10" Opacity="0.7" Foreground="{Binding Foreground, ElementName=AddressBar}"/>
                    <TextBox Name="FindBox" BorderThickness="0" Padding="6,3" FontSize="10"
                             VerticalContentAlignment="Center"
                             Background="{Binding Background, ElementName=AddressBar}"
                             Foreground="{Binding Foreground, ElementName=AddressBar}"
                             CaretBrush="{Binding Foreground, ElementName=AddressBar}"
                             TextChanged="FindBox_TextChanged" PreviewKeyDown="FindBox_PreviewKeyDown"/>
                </DockPanel>
            </Border>
            <!-- 加载完成后折叠整行，不预留空白。 -->
            <Border Grid.Row="3" Name="PageLoadingPanel" Visibility="Collapsed" Height="24" ClipToBounds="True"
                    Background="{Binding Background, ElementName=TopToolbar}">
                <StackPanel Margin="6,2">
                    <ProgressBar IsIndeterminate="True" Height="2"
                                 Background="Transparent" BorderThickness="0" Foreground="#0A84FF"/>
                    <DockPanel Margin="0,1,0,0">
                        <TextBlock Name="PageLoadingText" Text="正在加载…" FontSize="11" Margin="0,0,6,0"
                                   Foreground="{Binding Foreground, ElementName=AddressBar}"/>
                        <TextBlock Name="PageLoadingHost" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Opacity="0.6"
                                   Foreground="{Binding Foreground, ElementName=AddressBar}"/>
                        <TextBlock Name="PageLoadingSlowHint" Margin="6,0,0,0" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Opacity="0.6" Visibility="Collapsed"
                                   Foreground="{Binding Foreground, ElementName=AddressBar}"
                                   Text="网站响应较慢，仍在等待…"/>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Grid Grid.Row="2" Name="BrowserHost">
                <wv2:WebView2 Name="webView"/>
            </Grid>
        </Grid>
        
        <!-- 底部功能按钮栏 -->
        <Border Grid.Row="2" Name="BottomToolbar" Background="#3C3C3C" BorderBrush="#555" BorderThickness="0,1,0,0">
            <Grid Name="BottomToolbarGrid" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                
                <!-- 后退按钮 -->
                <Button Grid.Column="0" Name="BackButton" Content="‹" 
                        Style="{StaticResource ToolbarButtonStyle}" Click="BackButton_Click"
                        MouseRightButtonUp="BackButton_RightClick"/>
                
                <!-- 前进按钮 -->
                <Button Grid.Column="1" Name="ForwardButton" Content="›" 
                        Style="{StaticResource ToolbarButtonStyle}" Click="ForwardButton_Click"
                        MouseRightButtonUp="ForwardButton_RightClick"/>
                
                <!-- 刷新按钮 -->
                <Button Grid.Column="2" Name="RefreshButton" Content="⟳" 
                        Style="{StaticResource ToolbarButtonStyle}" Click="RefreshButton_Click"/>
                
                <!-- 收藏夹按钮 -->
                <Button Grid.Column="3" Name="BookmarkButton" Content="★" 
                        Style="{StaticResource ToolbarButtonStyle}" Click="BookmarkButton_Click"
                        ToolTip="收藏夹">
                    <Button.ContextMenu>
                        <ContextMenu Name="BookmarkContextMenu" Style="{StaticResource BrowserContextMenuStyle}"
                                     Opened="BrowserMenu_Opened">
                            <MenuItem Header="添加到收藏夹" Click="AddBookmark_Click"/>
                            <MenuItem Header="书签管理器" Click="ShowSettings_Bookmarks_Click"/>
                            <Separator Name="BookmarkSeparator"/>
                            <!-- 动态添加的收藏项将在这里 -->
                            <Separator Name="DynamicSeparatorEnd" Visibility="Collapsed"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                
                <Button Name="SettingsButton" Content="⚙"
                        Style="{StaticResource ToolbarButtonStyle}" Click="SettingsButton_Click"
                        ToolTip="设置 (Ctrl+,)"/>
                <Button Grid.Column="6" Name="MoreButton" Content="…"
                        Style="{StaticResource ToolbarButtonStyle}" Click="MoreButton_Click" ToolTip="更多">
                    <Button.ContextMenu>
                        <ContextMenu Name="MoreContextMenu" Style="{StaticResource BrowserContextMenuStyle}"
                                     Opened="MoreContextMenu_Opened">
                            <MenuItem Name="BackMenuItem" Header="后退" Click="BackButton_Click"/>
                            <MenuItem Name="ForwardMenuItem" Header="前进" Click="ForwardButton_Click"/>
                            <MenuItem Name="RefreshMenuItem" Header="刷新" Click="RefreshButton_Click"/>
                            <MenuItem Name="BookmarkMenuItem" Header="收藏夹" Click="ToolbarBookmarks_Click"/>
                            <MenuItem Name="PinMenuItem" Header="窗口置顶" IsCheckable="True" Click="TopMostButton_Click"/>
                            <MenuItem Name="ZoomMenuItem" Header="缩放" Click="ZoomButton_Click"/>
                            <MenuItem Name="OpenBrowserMenuItem" Header="用默认浏览器打开" Click="PopupButton_Click"/>
                            <MenuItem Name="UserAgentMenuItem" Header="手机 UA" IsCheckable="True" Click="UAButton_Click"/>
                            <MenuItem Name="DarkModeMenuItem" Header="暗色模式" IsCheckable="True" Click="DarkModeButton_Click"/>
                            <MenuItem Name="ProxyMenuItem" Header="代理">
                                <MenuItem Header="启用代理" Click="ProxyToggle_Click" IsCheckable="True" Name="ProxyToggleMenuItem2"/>
                                <MenuItem Header="代理设置" Click="ProxySettings_Click"/>
                                <MenuItem Header="重启实例（使代理生效）" Click="RestartApp_Click"/>
                            </MenuItem>
                            <MenuItem Name="SettingsMenuItem" Header="设置 (Ctrl+,)" Click="SettingsButton_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- 置顶按钮 -->
                <Button Grid.Column="4" Name="TopMostButton"
                        Style="{StaticResource ToolbarButtonStyle}" Click="TopMostButton_Click"
                        ToolTip="取消置顶">
                    <Path Width="10" Height="11" Stretch="Uniform"
                          Fill="{Binding Foreground, ElementName=TopMostButton}"
                          Data="M 4,0 L 10,0 L 9,6 L 12,9 L 12,10 L 7.7,10 L 7,15 L 6.3,10 L 2,10 L 2,9 L 5,6 Z"/>
                </Button>
                <Button Name="OpenBrowserButton" Content="↗" Visibility="Collapsed"
                        Style="{StaticResource ToolbarButtonStyle}" Click="PopupButton_Click" ToolTip="用默认浏览器打开"/>
                <Button Name="UserAgentButton" Content="UA" FontSize="10" Visibility="Collapsed"
                        Style="{StaticResource ToolbarButtonStyle}" Click="UAButton_Click" ToolTip="切换手机 / 桌面 UA"/>
                <Button Name="ThemeButton" Content="☾" Visibility="Collapsed"
                        Style="{StaticResource ToolbarButtonStyle}" Click="DarkModeButton_Click" ToolTip="切换黑白模式"/>
                <Button Name="ProxyButton" Content="◎" Visibility="Collapsed"
                        Style="{StaticResource ToolbarButtonStyle}" Click="ToolbarProxy_Click" ToolTip="代理">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource BrowserContextMenuStyle}" Opened="ToolbarProxyMenu_Opened">
                            <MenuItem Name="ToolbarProxyToggle" Header="启用代理" IsCheckable="True" Click="ProxyToggle_Click"/>
                            <MenuItem Header="代理设置" Click="ProxySettings_Click"/>
                            <MenuItem Header="重启实例（使代理生效）" Click="RestartApp_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                        
                <!-- 拖动按钮 -->
                <Label Grid.Column="7" Name="DragButton" Content=""
                       Background="Transparent" Foreground="White"
                       FontSize="16" Cursor="SizeAll"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"
                       ToolTip="拖拽移动窗口"/>
                       
                <Button Grid.Column="5" Name="ZoomButton" Content="80%" FontSize="10"
                        Style="{StaticResource ToolbarButtonStyle}" Click="ZoomButton_Click"
                        ToolTip="调整缩放比例"/>
                <Popup Name="ZoomPopup" PlacementTarget="{Binding ElementName=ZoomButton}"
                       Placement="Top" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{Binding Background, ElementName=BottomToolbar}"
                            BorderBrush="{Binding BorderBrush, ElementName=BottomToolbar}"
                            BorderThickness="1" CornerRadius="6" Padding="8">
                        <StackPanel Orientation="Horizontal">
                            <Button Name="ZoomOutButton" Content="-" Width="28"
                                    Style="{StaticResource ToolbarButtonStyle}" Click="ZoomOut_Click" ToolTip="缩小"/>
                            <TextBox Name="ZoomPercentInput" Width="60" Padding="4" VerticalContentAlignment="Center"
                                     Background="{Binding Background, ElementName=AddressBar}"
                                     Foreground="{Binding Foreground, ElementName=AddressBar}"
                                     BorderBrush="{Binding BorderBrush, ElementName=BottomToolbar}"
                                     KeyDown="ZoomPercentInput_KeyDown" LostKeyboardFocus="ZoomPercentInput_LostKeyboardFocus"
                                     ToolTip="输入 30–300，按 Enter 应用"/>
                            <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0"
                                       Foreground="{Binding Foreground, ElementName=AddressBar}"/>
                            <Button Name="ZoomInButton" Content="+" Width="28"
                                    Style="{StaticResource ToolbarButtonStyle}" Click="ZoomIn_Click" ToolTip="放大"/>
                        </StackPanel>
                    </Border>
                </Popup>

                
                <!-- 窗口调整按钮 ↘ -->
                <Label Grid.Column="8" Name="ResizeButton" Content=""
                       Background="Transparent" Foreground="White"
                       FontSize="16" Cursor="SizeNWSE"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"
                       ToolTip="拖拽调整窗口大小"/>

            </Grid>
        </Border>
        </Grid>
    </Border>
</Window>