<Window x:Class="TrayChrome.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Height="600"
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="600"
        MinHeight="500">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 主内容区域 - 使用 TabControl 分类 -->
        <TabControl Name="MainTabControl" Grid.Row="0" Margin="0,0,0,10">
            <!-- 窗口设置 -->
            <TabItem Header="窗口设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="窗口大小">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <Label Grid.Row="0" Grid.Column="0" Content="宽度:"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Name="WidthTextBox"/>
                                
                                <Label Grid.Row="0" Grid.Column="2" Content="高度:"/>
                                <TextBox Grid.Row="0" Grid.Column="3" Name="HeightTextBox"/>
                                
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" 
                                       Content="提示：修改后需要重启窗口才能生效" 
                                       Foreground="Gray" FontSize="10"/>
                            </Grid>
                        </GroupBox>
                        
                        <GroupBox Header="窗口行为">
                            <StackPanel>
                                <CheckBox Name="TopMostCheckBox" Content="窗口置顶"/>
                                <CheckBox Name="SuperMinimalModeCheckBox" Content="极简模式（隐藏工具栏）"/>
                                <CheckBox Name="AnimationCheckBox" Content="启用窗口动画"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- 外观设置 -->
            <TabItem Header="外观设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="主题">
                            <StackPanel>
                                <CheckBox Name="DarkModeCheckBox" Content="暗色模式"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="圆角设置">
                            <StackPanel>
                                <CheckBox Name="RoundedCornersCheckBox" Content="启用圆角（极简模式下四周圆角）"/>
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="圆角大小:"/>
                                    <TextBox Grid.Column="1" Name="CornerRadiusTextBox" ToolTip="圆角半径，单位像素 (px)"/>
                                    <Label Grid.Column="2" Content="px"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="图标设置">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <RadioButton Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Name="DefaultIconRadio" Content="默认图标" Tag="default" Margin="5"/>
                                <RadioButton Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Name="DingDingIconRadio" Content="钉钉" Tag="dingding" Margin="5"/>
                                <RadioButton Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Name="FeishuIconRadio" Content="飞书" Tag="feishu" Margin="5"/>
                                <RadioButton Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Name="WecomIconRadio" Content="企业微信" Tag="wecom" Margin="5"/>
                                <RadioButton Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Name="WeixinIconRadio" Content="微信" Tag="weixin" Margin="5"/>
                                <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Name="CustomIconButton" Content="选择自定义图标..." Margin="5" Click="CustomIconButton_Click"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- 浏览器设置 -->
            <TabItem Header="浏览器设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="缩放">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="缩放比例:"/>
                                    <Slider Grid.Column="1" Name="ZoomSlider" Minimum="0.3" Maximum="3.0" TickFrequency="0.1" 
                                            TickPlacement="BottomRight" Margin="5"/>
                                    <Label Grid.Column="2" Name="ZoomValueLabel" MinWidth="50"/>
                                </Grid>
                                <CheckBox Name="AutoZoomOutCheckBox" Content="启动后自动缩小比例 (80%)" Margin="5,0,5,5"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <GroupBox Header="用户代理">
                            <StackPanel>
                                <RadioButton Name="MobileUARadio" Content="移动设备 (手机)" IsChecked="{Binding IsMobileUA}" Margin="5"/>
                                <RadioButton Name="DesktopUARadio" Content="桌面设备 (PC)" Margin="5"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <GroupBox Header="代理服务器 (Proxy)">
                            <StackPanel>
                                <CheckBox Name="ProxyEnabledCheckBox" Content="启用代理" Margin="5"/>
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="代理地址:"/>
                                    <TextBox Grid.Column="1" Name="ProxyServerTextBox" ToolTip="例如：127.0.0.1:7890"/>
                                </Grid>
                                <Label Content="提示：修改代理后请重启浏览器生效！" 
                                       Foreground="Gray" FontSize="10" Margin="5,0,5,5"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- 广告拦截设置 -->
            <TabItem Header="广告拦截">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="启用">
                            <CheckBox Name="AdBlockEnabledCheckBox" Content="启用广告拦截"/>
                        </GroupBox>
                        
                        <GroupBox Header="拦截规则（每行一个，支持通配符 * 和域名匹配）">
                            <TextBox Name="AdBlockRulesTextBox" 
                                     AcceptsReturn="True" 
                                     VerticalScrollBarVisibility="Auto" 
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas"
                                     MinHeight="150"/>
                        </GroupBox>
                        
                        <GroupBox Header="允许规则（白名单，优先级高于拦截规则）">
                            <TextBox Name="AdAllowRulesTextBox" 
                                     AcceptsReturn="True" 
                                     VerticalScrollBarVisibility="Auto" 
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas"
                                     MinHeight="100"/>
                        </GroupBox>
                        
                        <Button Name="LoadDefaultRulesButton" Content="加载默认规则" Click="LoadDefaultRulesButton_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- 快捷键设置 -->
            <TabItem Header="快捷键">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="全局快捷键">
                            <StackPanel>
                                <CheckBox Name="EnableHotKeyCheckBox" Content="启用全局快捷键"/>
                                
                                <Grid Margin="5,10,5,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="快捷键:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Name="HotKeyTextBox" 
                                             ToolTip="格式：alt + x 或 ctrl + shift + x"/>
                                </Grid>
                                
                                <Label Content="提示：快捷键用于显示/隐藏窗口" 
                                       Foreground="Gray" 
                                       FontSize="10" 
                                       Margin="5,5,5,0"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <GroupBox Header="快捷键帮助">
                            <StackPanel Margin="5">
                                <TextBlock TextWrapping="Wrap" Margin="5">
                                    <Run Text="以下是在 TrayChrome 中可用的快捷键：" FontWeight="Bold"/>
                                    <LineBreak/><LineBreak/>
                                    <Run Text="• 中键(托盘图标)：" FontWeight="Bold"/>
                                    <Run Text="关闭 TrayChrome 实例"/>
                                    <LineBreak/>
                                    <Run Text="• Ctrl + 中键(托盘图标)：" FontWeight="Bold"/>
                                    <Run Text="关闭当前实例"/>
                                    <LineBreak/>
                                    <Run Text="• Ctrl + L：" FontWeight="Bold"/>
                                    <Run Text="聚焦到地址栏"/>
                                    <LineBreak/>
                                    <Run Text="• Ctrl + R：" FontWeight="Bold"/>
                                    <Run Text="刷新当前页面"/>
                                    <LineBreak/>
                                    <Run Text="• Ctrl + Shift + O：" FontWeight="Bold"/>
                                    <Run Text="打开书签菜单"/>
                                    <LineBreak/>
                                    <Run Text="• Ctrl + Shift + B：" FontWeight="Bold"/>
                                    <Run Text="切换极简模式（Clean 模式）"/>
                                    <LineBreak/>
                                    <Run Text="• Ctrl + 点击链接：" FontWeight="Bold"/>
                                    <Run Text="在新窗口中打开链接"/>
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- 收藏夹管理 -->
            <TabItem Header="收藏夹">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 工具栏 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                        <Button Name="AddBookmarkButton" Content="添加收藏" Click="AddBookmarkButton_Click"  Width="70" Padding="0,3"/>
                        <Button Name="EditBookmarkButton" Content="编辑" Click="EditBookmarkButton_Click"  Width="70" Padding="0,3"/>
                        <Button Name="DeleteBookmarkButton" Content="删除" Click="DeleteBookmarkButton_Click"  Width="70" Padding="0,3"/>
                        <Button Name="RefreshBookmarkButton" Content="刷新" Click="RefreshBookmarkButton_Click" Width="70" Padding="0,3"/>
                    </StackPanel>
                    
                    <!-- 收藏夹列表 -->
                    <ListBox Grid.Row="1" Name="BookmarkListBox" SelectionMode="Single" 
                             MouseDoubleClick="BookmarkListBox_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Url}" Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- 状态栏 -->
                    <TextBlock Grid.Row="2" Name="BookmarkStatusText" Margin="0,5,0,0" Foreground="Gray" FontSize="10"/>
                </Grid>
            </TabItem>

            <!-- 关于 -->
            <TabItem Header="关于">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="关于 TrayChrome">
                            <StackPanel Margin="5">
                                <TextBlock TextWrapping="Wrap" Margin="5">
                                    TrayChrome 是一个基于 WPF 和 WebView2 的轻量级托盘浏览器，类似 MenubarX，专为 Windows 设计。
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="版本">
                            <StackPanel Margin="5">
                                <StackPanel Orientation="Horizontal" Margin="5,0,5,5">
                                    <TextBlock Text="当前版本：" VerticalAlignment="Center"/>
                                    <TextBlock Name="VersionText" Text="1.3.0" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdateButton_Click" HorizontalAlignment="Left" Margin="5"/>
                                <TextBlock Name="UpdateStatusText" Foreground="Gray" FontSize="11" Margin="5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="项目链接">
                            <StackPanel Margin="5">
                                <Button Name="GitHubButton" Content="打开 GitHub 页面" Click="GitHubButton_Click" HorizontalAlignment="Left" Margin="5"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="作者联系方式">
                            <StackPanel Margin="5">
                                <Button Name="EmailButton" Content="kasusaland@gmail.com" Click="EmailButton_Click" HorizontalAlignment="Left" Margin="5" ToolTip="发送邮件给作者"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="命令行参数使用示例">
                            <StackPanel Margin="5">
                                <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="5">
                                    <Run Text="TrayChrome.exe" FontWeight="Bold"/><LineBreak/>
                                    <Run Text="TrayChrome.exe --url https://www.baidu.com"/><LineBreak/>
                                    <Run Text="TrayChrome.exe --url https://www.google.com --open"/><LineBreak/>
                                    <Run Text="TrayChrome.exe --url https://jandan.net --open --clean"/><LineBreak/>
                                    <Run Text="TrayChrome.exe --unclean"/><LineBreak/>
                                    <Run Text="TrayChrome.exe --size 480x320 --url https://www.baidu.com --open"/><LineBreak/>
                                    <Run Text="TrayChrome.exe --help"/><LineBreak/><LineBreak/>
                                    <Run Text="参数说明：" FontWeight="Bold"/><LineBreak/>
                                    <Run Text="--url &lt;网址&gt;   指定启动时加载的网页"/><LineBreak/>
                                    <Run Text="--open         启动时直接显示窗口"/><LineBreak/>
                                    <Run Text="--clean        启用极简模式（隐藏工具栏）"/><LineBreak/>
                                    <Run Text="--unclean      强制禁用极简模式"/><LineBreak/>
                                    <Run Text="--size &lt;宽x高&gt;  指定窗口大小，如 480x320"/><LineBreak/>
                                    <Run Text="--help, -h     显示帮助信息"/>
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="工具推荐">
                            <StackPanel Margin="5">
                                <TextBlock TextWrapping="Wrap" Margin="5">
                                    在极简模式（Ctrl+Shift+B）下窗口无法拖拽，推荐使用 AltSnap 工具来移动和调整窗口大小。
                                </TextBlock>
                                <Button Name="AltSnapButton" Content="AltSnap (GitHub)" Click="AltSnapButton_Click" HorizontalAlignment="Left" Margin="5"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        
        <!-- 底部按钮 -->
        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="10,10,10,5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="OkButton" Content="保存并关闭" Click="OkButton_Click" IsDefault="True" MinWidth="120"/>
                <Button Name="ApplyButton" Content="应用" Click="ApplyButton_Click" MinWidth="100"/>
                <Button Name="CancelButton" Content="关闭" Click="CancelButton_Click" IsCancel="True" MinWidth="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

