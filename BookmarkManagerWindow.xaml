<Window x:Class="TrayChrome.BookmarkManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="书签管理器" Width="760" Height="600" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0">
                <Button Content="添加收藏" Click="AddBookmarkButton_Click"/>
                <Button Content="新建文件夹" Click="NewBookmarkFolder_Click"/>
                <Menu Background="Transparent" VerticalAlignment="Center" Margin="5">
                    <MenuItem Header="导入 / 导出" Padding="10,5">
                        <MenuItem Header="导入浏览器书签..." Click="ImportBookmarks_Click"/>
                        <MenuItem Header="导出 HTML..." Click="ExportBookmarks_Click"/>
                    </MenuItem>
                </Menu>
                <Button Content="打开配置文件" Click="OpenBookmarkConfig_Click"/>
                <Button Content="刷新" Click="RefreshBookmarkButton_Click"/>
            </WrapPanel>
            <DockPanel Grid.Column="1" VerticalAlignment="Top" Margin="8,5,0,0">
                <Button DockPanel.Dock="Right" Content="搜索" Click="BookmarkSearch_Click"
                        Margin="5,0,0,0" Padding="8,3"/>
                <TextBox Name="BookmarkSearchBox" KeyDown="BookmarkSearch_KeyDown"
                         ToolTip="输入名称或 URL，点击搜索或按 Enter 执行；清空后搜索显示全部"
                         Padding="4,2" VerticalContentAlignment="Center"/>
            </DockPanel>
            </Grid>
        </StackPanel>
        <DockPanel Grid.Row="1">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                <TextBlock DockPanel.Dock="Left" Text="书签" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button DockPanel.Dock="Right" Content="全部折叠" Click="CollapseAllBookmarks_Click"
                        Margin="8,0,0,0" Padding="8,3"/>
                <ComboBox Name="BookmarkFolderCombo" DisplayMemberPath="Path" VerticalAlignment="Center"
                          SelectionChanged="BookmarkFolder_SelectionChanged"/>
            </DockPanel>
        <TreeView Name="BookmarkListBox" HorizontalContentAlignment="Stretch"
                  AllowDrop="True" PreviewMouseLeftButtonDown="BookmarkTree_MouseDown"
                  MouseMove="BookmarkTree_MouseMove" DragOver="BookmarkTree_DragOver"
                  Drop="BookmarkTree_Drop" SelectedItemChanged="BookmarkTree_SelectedItemChanged"
                  PreviewMouseRightButtonDown="BookmarkTree_RightClick" PreviewKeyDown="BookmarkTree_KeyDown"
                  ContextMenuOpening="BookmarkTree_ContextMenuOpening"
                  MouseDoubleClick="BookmarkListBox_MouseDoubleClick">
            <TreeView.ContextMenu>
                <ContextMenu/>
            </TreeView.ContextMenu>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <Grid Margin="2,0" Height="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Url}" Foreground="Gray" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        </DockPanel>
        <TextBlock Grid.Row="2" Name="BookmarkStatusText" Margin="0,5,0,0" Foreground="Gray" FontSize="10"/>
    </Grid>
</Window>
